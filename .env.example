# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). .env.local is
# gitignored; never commit real credentials.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EmailJS (Account > API Keys for the public key, Email Services for the
# service ID). The template must define to_email, to_name, subject, and
# message variables.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
